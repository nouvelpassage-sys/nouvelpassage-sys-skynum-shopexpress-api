SKYNUM_API_TOKEN=put_non_admin_api_user_token_here

# Product assistant Telegram bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=NouvelProductAssistantBot
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_API_BASE_URL=https://api.telegram.org/
# When true, the Telegram bot will publish QA-clean product cards automatically,
# but only if SALESBOX_WRITE_ENABLED=true as well.
TELEGRAM_AUTO_PUBLISH_READY=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4
PRODUCT_ASSISTANT_DATA_DIR=data/product-assistant
# For Railway with a mounted volume use:
# PRODUCT_ASSISTANT_DATA_DIR=/data/product-assistant

# Product image storage. Use static-public when IMAGE_STORAGE_DIR is served at IMAGE_STORAGE_PUBLIC_BASE_URL.
# Use salesbox-s3 after confirming the admin upload token and internal SalesBox company id.
# Use cloudinary-unsigned with CLOUDINARY_CLOUD_NAME and an unsigned upload preset for quick public image URLs.
IMAGE_STORAGE_PROVIDER=none
IMAGE_STORAGE_DIR=data/product-assistant/public-images
IMAGE_STORAGE_PUBLIC_BASE_URL=
SALESBOX_ADMIN_API_BASE_URL=https://prod.salesbox.me/api/
SALESBOX_ADMIN_API_TOKEN=
SALESBOX_ADMIN_COMPANY_ID=
SALESBOX_UPLOAD_ITEM_TYPE=services
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=
CLOUDINARY_FOLDER=nouvel-amour/products

# SalesBox integration: keep writes disabled until image hosting and final write tests are verified.
SALESBOX_API_BASE_URL=https://prod.salesbox.me/openapi/
SALESBOX_API_TOKEN=
SALESBOX_COMPANY_ID=
SALESBOX_WRITE_ENABLED=false

# Telegram product assistant second channel.
# SalesBox is the primary mobile-app target; ShopExpress can be queued in parallel.
SHOP_EXPRESS_CHANNEL_ENABLED=false
SHOP_EXPRESS_WRITE_ENABLED=false
SHOP_EXPRESS_IMPORT_QUEUE_PATH=data/product-assistant/shopexpress-pending-import.csv
# For Railway with a mounted volume use:
# SHOP_EXPRESS_IMPORT_QUEUE_PATH=/data/product-assistant/shopexpress-pending-import.csv
SHOP_EXPRESS_IMPORT_LINK_ENABLED=true
SHOP_EXPRESS_IMPORT_CLOUDINARY_CLOUD_NAME=
SHOP_EXPRESS_IMPORT_CLOUDINARY_UPLOAD_PRESET=
SHOP_EXPRESS_IMPORT_CLOUDINARY_FOLDER=nouvel-amour/products/imports
SHOP_EXPRESS_BASE_URL=
SHOP_EXPRESS_USERNAME=
SHOP_EXPRESS_PASSWORD=
SHOP_EXPRESS_PRODUCTS_UPSERT_PATH=/api/products
